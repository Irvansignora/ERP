  deliveredQty  Decimal @default(0) @db.Decimal(19, 4) @map("delivered_qty")
  unitPrice     Decimal @db.Decimal(19, 4) @map("unit_price")
  discount      Decimal @default(0) @db.Decimal(19, 4)
  totalPrice    Decimal @db.Decimal(19, 4) @map("total_price")
  vatAmount     Decimal @default(0) @db.Decimal(19, 4) @map("vat_amount")

  @@unique([salesOrderId, lineNumber])
  @@map("sales_order_lines")
}

