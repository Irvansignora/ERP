  email       String?
  isActive    Boolean  @default(true) @map("is_active")
  isHeadOffice Boolean @default(false) @map("is_head_office")

  @@map("branches")
}

// ============================================
// API INTEGRATIONS LOG (Feature 14 - NEW)
// ============================================

model IntegrationLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")

  integrationType String @map("integration_type") // PAYMENT_GATEWAY, MARKETPLACE, SHIPPING
  provider      String   // MIDTRANS, TOKOPEDIA, JNTE, etc.
  direction     String   // INBOUND, OUTBOUND
  endpoint      String?
  requestPayload Json?  @map("request_payload")
  responsePayload Json? @map("response_payload")
  statusCode    Int?   @map("status_code")
  status        String // SUCCESS, FAILED
  errorMessage  String? @map("error_message")
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type")

  @@index([integrationType])
  @@index([status])
  @@index([createdAt])
  @@map("integration_logs")
}

