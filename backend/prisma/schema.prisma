// ============================================
// INVENTORY MANAGEMENT (Feature 2 - NEW)
// ============================================

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  code        String   @unique
  name        String
  address     String?
  status      WarehouseStatus @default(ACTIVE)
  isDefault   Boolean  @default(false) @map("is_default")

  stocks      Stock[]
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")

  @@map("warehouses")
}

model Stock {
  id          String   @id @default(uuid())
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouseId String   @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])

  quantity    Decimal  @default(0) @db.Decimal(19, 4)
  reservedQty Decimal  @default(0) @db.Decimal(19, 4) @map("reserved_qty")
  minimumQty  Decimal  @default(0) @db.Decimal(19, 4) @map("minimum_qty")

  batchNumber String?  @map("batch_number")
  serialNumber String? @map("serial_number")
  expiryDate  DateTime? @map("expiry_date")

  @@unique([warehouseId, productId, batchNumber])
  @@index([warehouseId])
  @@index([productId])
  @@map("stocks")
}

model StockMovement {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")

  movementType  StockMovementType @map("movement_type")
  movementDate  DateTime @map("movement_date")
  referenceType String?  @map("reference_type") // SALES_ORDER, PURCHASE_ORDER, etc.
  referenceId   String?  @map("reference_id")

  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])

  fromWarehouseId String? @map("from_warehouse_id")
  fromWarehouse   Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId   String?  @map("to_warehouse_id")
  toWarehouse     Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])

  quantity      Decimal  @db.Decimal(19, 4)
  unitCost      Decimal? @db.Decimal(19, 4) @map("unit_cost")
  batchNumber   String?  @map("batch_number")
  serialNumber  String?  @map("serial_number")
  notes         String?

  @@index([movementType])
  @@index([movementDate])
  @@index([productId])
  @@map("stock_movements")
}

